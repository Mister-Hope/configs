{
  "name": "stylelint-config-hope",
  "version": "13.0.0",
  "description": "Shareable config for Stylelint",
  "keywords": [
    "stylelint",
    "stylelint-config"
  ],
  "homepage": "https://github.com/Mister-Hope/configs/tree/main/packages/stylelint-config-hope",
  "bugs": {
    "url": "https://github.com/Mister-Hope/configs/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Mr.Hope",
    "email": "mister-hope@outlook.com",
    "url": "https://mister-hope.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mister-Hope/configs.git",
    "directory": "packages/stylelint-config-hope"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf ./dist",
    "test": "stylelint \"tests/**/*.scss\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "stylelint-config-standard": "^41.0.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "stylelint-order": "^8.1.3"
  },
  "devDependencies": {
    "@mr-hope/tsconfig": "workspace:*",
    "import-meta-resolve": "4.2.0"
  },
  "peerDependencies": {
    "postcss-html": "^2.0.0",
    "stylelint": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "postcss-html": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "inlinedDependencies": {
    "import-meta-resolve": "4.2.0"
  }
}
