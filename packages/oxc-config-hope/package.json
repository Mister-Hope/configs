{
  "name": "oxc-config-hope",
  "version": "0.3.15",
  "description": "Personal configuration for oxc.",
  "keywords": [
    "eslint",
    "oxc",
    "oxfmt",
    "oxlint",
    "prettier",
    "typescript"
  ],
  "license": "ISC",
  "author": {
    "name": "Mister-Hope",
    "email": "mister-hope@outlook.com",
    "url": "https://mister-hope.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mister-Hope/configs.git",
    "directory": "packages/oxc-config-hope"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./oxfmt": {
      "types": "./dist/oxfmt.d.ts",
      "default": "./dist/oxfmt.js"
    },
    "./oxlint": {
      "types": "./dist/oxlint.d.ts",
      "default": "./dist/oxlint.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf ./dist",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@mr-hope/tsconfig": "workspace:*"
  },
  "peerDependencies": {
    "oxfmt": ">=0.72.0 && < 1.0.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": ">=7.0.2"
  },
  "peerDependenciesMeta": {
    "oxfmt": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "oxlint-tsgolint": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
