{
  "name": "eslint-config-mister-hope",
  "version": "0.11.1",
  "description": "eslint config for personal usage",
  "keywords": [
    "eslint",
    "eslint-config"
  ],
  "license": "MIT",
  "author": {
    "name": "Mister-Hope",
    "email": "mister-hope@outlook.com",
    "url": "https://mister-hope.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mister-Hope/configs.git",
    "directory": "packages/eslint-config-mister-hope"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "default": "./dist/vue.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf ./dist",
    "lint:eslint": "eslint .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@typescript-eslint/utils": "^8.71.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.1"
  },
  "devDependencies": {
    "@mr-hope/tsconfig": "workspace:*",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "eslint-plugin-vue": "^10.2.0",
    "vue-eslint-parser": "^10.1.3"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-vue": {
      "optional": true
    },
    "vue-eslint-parser": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || ^26.0.0"
  }
}
