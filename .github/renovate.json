{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":prHourlyLimitNone",
    ":prConcurrentLimitNone",
    "helpers:disableTypesNodeMajor"
  ],
  "dependencyDashboard": true,
  "schedule": ["every weekend"],
  "packageRules": [
    {
      "description": "Patch/minor devDependency updates are safe to merge automatically.",
      "automerge": true,
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"]
    },
    {
      "description": "Major devDependency updates need a human review.",
      "automerge": false,
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["major"]
    },
    {
      "description": "typescript-eslint only supports TypeScript <6.1, so the eslint preset stays on TypeScript 6 until type-eslint supports the next major.",
      "matchDepNames": ["typescript"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "commitMessageAction": "update lockfile",
    "platformAutomerge": true,
    "extends": ["group:allNonMajor", "schedule:weekly"]
  },
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "minimumReleaseAge": "1 day",
  "timezone": "Asia/Shanghai"
}
