{
  "name": "@mr-hope/configs",
  "version": "0.0.0",
  "private": true,
  "description": "Unified configuration presets for TypeScript, oxc, ESLint, Stylelint and conventional commit messages.",
  "keywords": [
    "config",
    "eslint",
    "eslint-config",
    "oxc",
    "oxfmt",
    "oxlint",
    "stylelint",
    "stylelint-config",
    "tsconfig",
    "typescript"
  ],
  "license": "MIT",
  "author": {
    "name": "Mr.Hope",
    "email": "mister-hope@outlook.com",
    "url": "https://mister-hope.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mister-Hope/configs.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm run --stream -r build",
    "clean": "pnpm run --stream -r clean",
    "lint": "oxlint --fix && oxfmt",
    "lint:check": "oxlint && oxfmt --check",
    "lint:eslint": "pnpm --filter eslint-config-mister-hope run lint:eslint",
    "packages:check-update": "pnpm dlx npm-check-updates",
    "packages:update": "pnpm up -r",
    "prepare": "husky && pnpm --filter @mr-hope/verify-commit-message run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:stylelint": "pnpm --filter stylelint-config-hope run test",
    "type-check": "tsc --noEmit && pnpm -r run type-check"
  },
  "devDependencies": {
    "@lerna-lite/cli": "5.6.4",
    "@lerna-lite/publish": "5.6.4",
    "@mr-hope/tsconfig": "workspace:*",
    "@mr-hope/verify-commit-message": "workspace:*",
    "@types/node": "24.19.2",
    "@vitest/coverage-istanbul": "5.0.5",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "eslint": "10.14.0",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "nano-staged": "1.0.2",
    "npm-check-updates": "23.1.1",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "publint": "0.3.25",
    "rimraf": "6.1.3",
    "stylelint": "17.16.0",
    "tsdown": "0.23.4",
    "typescript": "7.0.2",
    "unrun": "0.3.1",
    "vitest": "5.0.5"
  },
  "nano-staged": {
    "**/*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,ts}": "oxlint --fix"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^22.23.4 || ^24.22.1 || ^26.13.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
